# .env.test — configuration for the TEST instance of the bot.
#
# This file must live at /opt/nutrition-bot/.env.test on the server and is NOT
# tracked in git (see .gitignore — *.env is excluded). Copy this template to
# .env.test, fill in real values, and chmod it to 600.
#
# What's different from prod:
#   - TELEGRAM_BOT_TOKEN  points at a SEPARATE bot (created via @BotFather).
#   - NUTRITION_DB_PATH   writes to a separate SQLite file.
#   - WIKI_DIR            writes long-term memory to a separate directory.
# ANTHROPIC_API_KEY can be the same key as prod — the test bot just shares
# your Anthropic usage.

TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TEST_BOT_TOKEN_FROM_BOTFATHER
ANTHROPIC_API_KEY=REPLACE_WITH_YOUR_ANTHROPIC_API_KEY
NUTRITION_DB_PATH=/opt/nutrition-bot/nutrition.test.db
WIKI_DIR=/opt/nutrition-bot/wiki.test
